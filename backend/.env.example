# Reference only: the server reads process environment, not this file automatically.
PORT=8000
JAM_TRUST_PROXY=false
# Set the actual Render HTTPS origin after the service is created; no trailing path.
JAM_PUBLIC_ORIGIN=
JAM_ALLOWED_ORIGINS=https://veyra-website-mauve.vercel.app
JAM_MAX_MEMBERS=5
JAM_MAX_PARTIES=50
JAM_MAX_UPCOMING_QUEUE=25
# Optional Android App Links verification. Public certificate fingerprints, not a private key.
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
# No TURN credentials are required: this protocol does not use WebRTC.
