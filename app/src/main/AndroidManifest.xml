<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tells Wi-Fi from mobile data, so the matching quality ceiling applies. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Saving a track to Music outlives the screen it was asked from. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Touch feedback. The system's own haptics switch is honoured on top of
         this, so granting it doesn't override a user who turned buzzing off. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Asked for only when the output picker is first opened, and only on API 31+
      where it exists. Without it a paired headset is listed by the audio
      framework under a generic name rather than its own, which turns a list of
      places to send the music into a list of things called "Bluetooth".
      Everything else in the app works without it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      In-app updates: handing a downloaded APK to the system installer. The
      per-app "install unknown apps" switch is still the user's to flip; this
      only lets the request reach the installer.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reading local audio files across the device -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Only for API 28 and below. From 29 the app writes to the shared Music
      folder through MediaStore, which grants access to the rows it created and
      needs no permission at all — and this one stops being grantable there.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".VeyraApplication"
        android:allowBackup="true"
        android:appCategory="audio"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_wave_glass"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_wave_glass"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyra"
        tools:targetApi="34">

        <!--
          One UI 7+ only routes an app's ongoing notification to Live
          Notifications / the Now Bar if the app opts in here. Ignored by every
          other OEM. Samsung additionally gates the non-media Live Notification
          extras behind a per-package allowlist; the media card does not need it.
        -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Android Auto support -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
          No android:screenOrientation here, deliberately: the app follows the
          system's own auto-rotate setting on every device, phones included.

          [android:configChanges] is the other half of that: without it, a
          rotation the system now allows is still a full Activity restart,
          which throws away every bit of in-memory Compose state along with
          it — the sheet showing Now Playing, whether the lyrics or queue
          panel was open, mid-scrub position, all of it — before any of this
          screen's own responsive layout logic ever gets a chance to run.
          Declaring these configurations here is what turns a rotation back
          into an ordinary recomposition: the same Activity keeps running,
          the same state survives, and the width- and height-aware branches
          in NowPlayingScreen.kt decide the new layout.

          uiMode is deliberately *not* in the list: a day/night change should
          still recreate the Activity so the theme is rebuilt from resources.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Veyra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!--
                  What makes the system call this a music app. "Play music" from
                  the assistant, Android Auto's media list and the OEM pickers
                  that put up "Complete action using" all ask for
                  MAIN/APP_MUSIC by name and list whoever answers — a launcher
                  entry alone is not enough, which is why Veyra was missing
                  from that dialog while every other player on the device was in
                  it.
                -->
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              The pre-Lollipop spelling of the same request. Deprecated, and
              still what some OEM shortcuts and headset "open music" buttons
              fire, so it costs one filter to be reachable from them too.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              "Play <something>" said out loud, and the search a media app is
              handed when the assistant has words but no app in mind. An empty
              query means "play music" with nothing said about what, which is
              resumed rather than searched — see [MusicLink].
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              YouTube Music links: a song, an album, a playlist or an artist,
              tapped anywhere on the device.

              Not autoVerify. Verification is a claim to *own* these domains,
              which Veyra doesn't — and on Android 12+ an app that has
              verified them (the YouTube Music app itself) takes the link
              without a dialog either way. Declaring the filter is what puts
              Veyra in the "Open with" list once the user turns YT Music's
              "Open supported links" off; the SEND filter below is the path
              that always works, because sharing asks rather than routing.

              One host, not a family of them. Every entry here becomes a line
              the user has to tick under "Supported web addresses", so a
              plausible-looking host that never appears in a real link (a `www.`
              form of this one, say) is a line to tick by mistake instead of the
              one that matters.

              Schemes and paths still multiply out: every scheme × every path
              prefix listed here is one accepted shape.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/browse" />
                <data android:pathPrefix="/channel" />
                <data android:pathPrefix="/search" />
            </intent-filter>
            <!--
              youtu.be short links, which are a bare video id and nothing else.
              Kept in their own filter because the path there *is* the id, so it
              can't share the path prefixes above.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!-- Public Listen Together invites. autoVerify makes a tap open
                 Veyra directly once the domain publishes its assetlinks
                 association for the production signing certificate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="veyra-listen-together.onrender.com"
                    android:pathPattern="/invite/......" />
            </intent-filter>

            <!-- Custom scheme for Listen Together invites on custom server deployments. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="veyra"
                    android:host="party" />
            </intent-filter>

            <!--
              Share → Veyra, from YT Music's own share sheet or from
              anywhere a link can be sent. The text is whatever the sending app
              wrote around the URL, so the URL is picked out of it rather than
              parsed whole.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

