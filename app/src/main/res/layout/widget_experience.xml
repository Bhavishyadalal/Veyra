<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_pill_background">
<ImageView android:id="@+id/widget_experience_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom" android:padding="12dp" android:orientation="vertical">
<TextView android:id="@+id/widget_experience_lyric" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="24sp" android:fontFamily="serif" android:maxLines="5" android:ellipsize="end" android:visibility="gone" />
<TextView android:id="@id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal"><ImageButton android:id="@id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_previous" android:padding="12dp" android:contentDescription="@string/immersive_previous" />
<ImageButton android:id="@id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_play" android:padding="12dp" android:contentDescription="@string/immersive_play" />
<ImageButton android:id="@id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_next" android:padding="12dp" android:contentDescription="@string/immersive_next" />
</LinearLayout></LinearLayout></FrameLayout>
